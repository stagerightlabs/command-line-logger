{
    "name": "stagerightlabs/command-line-logger",
    "description": "Write log messages to the command line while respecting output verbosity",
    "keywords": [
        "laravel",
        "command line",
        "logger",
        "logging"
    ],
    "homepage": "https://github.com/stagerightlabs/command-line-logger",
    "license": "Apache-2.0",
    "type": "library",
    "authors": [
        {
            "name": "Ryan C. Durham",
            "email": "ryan@stagerightlabs.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "monolog/monolog": "^3.8",
        "symfony/var-dumper": "^7.2|^8.0"
    },
    "autoload": {
        "psr-4": {
            "StageRightLabs\\CommandLineLogger\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StageRightLabs\\CommandLineLogger\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StageRightLabs\\CommandLineLogger\\Provider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    }
}
